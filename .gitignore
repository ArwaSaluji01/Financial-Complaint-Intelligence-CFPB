
# Raw datasets
data/raw/*
data/processed/*

# Preserve acquisition metadata
!data/raw/dataset_metadata.json

# Preserve directory structure
!data/raw/.gitkeep
!data/processed/.gitkeep

# Model checkpoints and artifacts
models/*
!models/baseline/.gitkeep
!models/transformer/.gitkeep

# Generated reports
reports/figures/*
reports/metrics/*

# Preserve directory structure and dataset inspection
!reports/figures/.gitkeep
!reports/metrics/.gitkeep
!reports/metrics/dataset_inspection.json
!reports/metrics/dataset_inspection.txt
